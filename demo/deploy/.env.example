# Public hostname of the VM. With an Azure DNS name label this looks like:
#   prism-bio.eastus.cloudapp.azure.com
API_DOMAIN=prism-bio.eastus.cloudapp.azure.com

# Sites allowed to call the API from a browser (your GitHub Pages origin)
ALLOWED_ORIGINS=https://rishimj.github.io

RATE_LIMIT_PER_MINUTE=30
TORCH_THREADS=2
MAX_SEQUENCE_LENGTH=400
